# Copy this file to "Secrets.env" (same folder) and paste your keys after the = sign.
# Secrets.env is ignored by git, so your keys never leave your Mac.

# https://hardcover.app/account/api  (copy the token WITHOUT the word "Bearer")
HARDCOVER_TOKEN=

# Optional – raises the Google Books daily limit
# https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_BOOKS_API_KEY=

# Later, when we build payments
REVENUECAT_IOS_KEY=
REVENUECAT_ANDROID_KEY=
